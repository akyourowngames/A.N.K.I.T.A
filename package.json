{
  "name": "ankita",
  "version": "2.4.3",
  "private": true,
  "type": "module",
  "description": "Terminal coding agent powered by GitHub Copilot models, with shell and file-editing tools.",
  "author": "Ankita",
  "repository": {
    "type": "git",
    "url": "https://github.com/akyourowngames/A.N.K.I.T.A.git"
  },
  "bin": {
    "ankita": "chat.mjs",
    "ankita-chat": "chat.mjs"
  },
  "main": "desktop/electron/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "start": "node chat.mjs",
    "models": "node chat.mjs --list-models",
    "config": "node chat.mjs --config",
    "bench": "node scripts/bench/bench-latency.mjs",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:build": "tsc --noEmit -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "desktop:start": "electron .",
    "desktop:icon": "node desktop/scripts/make-icon.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --dir --config desktop/packaging/electron-builder.yml",
    "desktop:package": "npm run desktop:build && electron-builder --publish never --config desktop/packaging/electron-builder.yml",
    "desktop:package:win": "npm run desktop:build && electron-builder --win --publish never --config desktop/packaging/electron-builder.yml",
    "desktop:release": "npm run desktop:build && electron-builder --win --publish always --config desktop/packaging/electron-builder.yml"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "6.4.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright": "1.63.0"
  }
}
