# Provider selection
ANKITA_PROVIDER=copilot

# Copilot settings
COPILOT_MODEL=gpt-4o

# Codex CLI settings
# Set ANKITA_PROVIDER=codex_cli after running `codex login`.
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=xhigh
CODEX_SANDBOX=danger-full-access
CODEX_ENABLE_WEB_SEARCH=false
CODEX_EXEC_TIMEOUT_SEC=600
CODEX_DEVICE_AUTH=false

# Browser extension bridge settings
BROWSER_AUTOMATION_BACKEND=auto
BROWSER_BRIDGE_HOST=127.0.0.1
BROWSER_BRIDGE_PORT=8766
BROWSER_BRIDGE_AUTOSTART=true
BROWSER_BRIDGE_COMMAND_TIMEOUT_SEC=30
BROWSER_BRIDGE_FAST_TIMEOUT_SEC=10

# OpenAI settings
# Set ANKITA_PROVIDER=openai to use these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-codex
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice gateway settings
VOICE_SESSION_MAX_MESSAGES=32
VOICE_SESSION_MAX_CHARS=20000
VOICE_RESET_ON_OVERFLOW=true
