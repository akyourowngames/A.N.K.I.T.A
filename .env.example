# Copy to .env (project) or ~/.copilot-chat-cli/config.env (global fallback).
USERNAME=krish
AGENT_NAME=ankita
# MODEL=gpt-4.1
# SYSTEM_EXTRA=
TOOLS=on
AUTO_APPROVE=off
HISTORY_MESSAGES=40
# MAX_TOKENS=4096
# MAX_TOOL_CHARS=65536
# Tool rounds per request before the runtime stops the loop and asks for a summary (1-200).
# MAX_TOOL_STEPS=100
# MAX_TOOL_CALLS=60
# ANKITA_AGENT_DEBUG=1
# CONTEXT_WINDOW=32768
# INPUT_COST_PER_MILLION=
# OUTPUT_COST_PER_MILLION=
# CLI backend: copilot (default), groq (low latency, reuses GROQ_API_KEY), or
# kilo (Kilo AI Gateway, keyless free models). Fresh desktop installs use Kilo
# with poolside/laguna-s-2.1:free unless a provider was configured.
# PROVIDER=copilot
# Optional tool-loop model: the primary handles chat and the first tool
# decision; once a turn uses a tool, this model runs the loop and the primary
# writes the reply. Blank = single model for everything.
# TOOL_PROVIDER=kilo
# TOOL_MODEL=nex-agi/nex-n2.5-mini:free
# API_BASE=
# API_KEY=
# Image tools (all three are separate: generate, search Unsplash, search Pixabay).
# Image generation uses this OpenAI-compatible /images/generations endpoint;
# if IMAGE_API_BASE/KEY are blank it falls back to API_BASE/API_KEY.
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# UNSPLASH_ACCESS_KEY=
# PIXABAY_API_KEY=
# Connected apps: provide your Composio project key to enable Gmail, Slack,
# Notion, GitHub and other supported apps. Calls follow the configured approval
# tiers; a connected or trusted server does not bypass action approvals.
# COMPOSIO_API_KEY=ak_...
# Optional managed broker client (used only when COMPOSIO_API_KEY is empty).
# COMPOSIO_BROKER_URL=https://your-broker.example
# COMPOSIO_BROKER_TOKEN=  # optional; auto-registration stores a token locally
# COMPOSIO_API=           # optional REST endpoint override for testing
# COMPOSIO_TOOLKITS_API=  # optional toolkit catalog endpoint override
# GROQ_API_KEY=
# Voice-only planner: blank keeps the typed chat model. No chat provider changes.
# VOICE_PROVIDER=baseten
# VOICE_MODEL=meta-models/muse-spark-open-1026
# VOICE_API_BASE=             # optional endpoint override for voice only
# BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_MAX_TOKENS=1024     # output tokens, clamped to at least 400 for reasoning
# BASETEN_REASONING_EFFORT=low
# STT_PROVIDER=auto          # auto|groq|sarvam; auto = groq when its key exists
# STT_MODEL=whisper-large-v3-turbo
# Sarvam AI speech (better on Hinglish/Indic): dashboard.sarvam.ai, ₹100 free.
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_MODE=translit   # translit|transcribe|verbatim|code-mixed output
# SARVAM_KEYTERMS=           # comma list; defaults to AGENT_NAME
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_SPEAKER_HI=sanchita_hi_assistant
# SARVAM_TTS_SPEAKER_EN=sanchita_en_companion
# SARVAM_TTS_LANGUAGE=en-IN  # used before a transcription reports a language
# TTS_PROVIDER=auto          # auto|groq|edge|sarvam; auto = groq with a key, else edge
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=                # overrides the provider default (Sarvam: speaker id)
# TTS_RATE=+0%
# SPEAK=off
# MIC_DEVICE=
# Hands-free voice (/voice): VAD auto-sends on a pause, barge-in interrupts speech.
# VOICE_VAD=on               # auto-stop + transcribe on silence (off = press Enter)
# VOICE_SILENCE_MS=1200      # pause length that ends a turn
# VOICE_NOISE_DB=-35         # silencedetect threshold
# VOICE_MAX_UTTERANCE_MS=30000
# VOICE_BARGE_IN=on          # talking over a reply interrupts it
# VOICE_BARGE_DB=-25         # barge-in threshold (higher = must be louder)
# VOICE_HFP_ROUTING=on       # keep Bluetooth speech audible while the mic is open
# VOICE_ADDRESS=sir          # salutation in summary notes; off/none disables it
# VOICE_SPEAK_ITEMS=8        # list items read before the "rest on screen" note
# VOICE_SPEAK_SENTENCES=6    # sentences read for long prose
# VOICE_SPEAK_MAX_CHARS=1200 # hard cap on any spoken reply
# VOICE_FULL_READ=off        # on = read replies in full, never summarize
# VOICE_SUMMARY_NOTE={address}, that's {spoken} of {total}. The rest is on your screen, {address}.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_VOICE_REPLY=off
# TELEGRAM_CONFIRM_TIMEOUT=300
# DAEMON_TICK=20
# MAX_CONCURRENT=4
# WATCH_ALERT_LLM=on
# WATCH_ALERT_PROMPT=
# BRIEFING_PROMPT=
# TIMEZONE=Asia/Kolkata  # IANA timezone; defaults to system local time
# QUIET_HOURS=22:00-08:00  # hold proactive notifications for a later digest
# DESKTOP_NOTIFICATIONS=on
# NTFY_URL=https://ntfy.sh/your-private-topic
# NTFY_TOKEN=
# DISCORD_WEBHOOK_URL=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# NOTIFY_TIMEOUT=10
# MEMORY_CONSOLIDATION=on  # also enables local per-turn journaling
# MEMORY_RECALL_CHARS=1600  # transient recall budget; 0 disables automatic candidates
# MEMORY_RECALL_BUDGET_MS=300  # automatic pre-turn recall waits at most this long for a slow embedding; the query still embeds in the background
# EMBEDDINGS=on  # enabled when Cloudflare credentials are configured
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=  # keep in global config.env; never commit tokens
# EMBED_MODEL=@cf/qwen/qwen3-embedding-0.6b
# EMBED_TIMEOUT_MS=2000  # total foreground budget, then local fallback
# EMBED_INDEX_TIMEOUT_MS=30000  # independent background indexing budget
# EMBED_QUERY_INSTRUCTION=Given a conversation message, retrieve relevant personal preferences, facts, past decisions and tasks that help answer it.
# MEMORY_CONSOLIDATION_HOUR=3  # local hour to start processing prior days
# MEMORY_BATCH_SIZE=4
# MEMORY_CHUNK_CHARS=12000
# MEMORY_TIMEOUT=60
# PROJECT_AUTO_DETECT=on  # attach the matching project when the working directory is inside its folder
# PROJECT_WORK_CAPTURE=on  # record a bounded per-turn audit (tool names and changed paths) in the journal
# PROJECT_AUTO_MAINTENANCE=on  # append a work-log line and sync session todos after a changed turn
# PROJECT_INLINE_CONSOLIDATION=off  # run one local extraction after qualifying turns; may add model calls
# PROJECT_AUDIT_MAX_TOOLS=20
# PROJECT_AUDIT_MAX_FILES=20
# PROJECT_WORKLOG_MAX=100
# PROJECT_TODO_SYNC_MAX=5
# PROJECT_INLINE_MIN_CHARS=400  # skip inline extraction for shorter transcripts
# PS_STRICT=1
# ANKITA_NO_WEB=
# ANKITA_NO_SCRAPE=
# WEB_TIMEOUT=20
# WEB_MAX_OUTPUT=8000
# WEB_CACHE_TTL=300
# WEB_RETRIES=1
# WEB_REGION=wt-wt
# JINA_FALLBACK=1
# ALLOW_PRIVATE_HOSTS=1   # opt in to watching loopback/LAN pages (off by default)
# SCRAPE_TIMEOUT=30
# SCRAPE_STEALTH_TIMEOUT=30
# SCRAPE_MAX_OUTPUT=8000
# SCRAPE_MAX_PAGES=20
# SCRAPE_RETRIES=1
# PYTHON_BIN=
