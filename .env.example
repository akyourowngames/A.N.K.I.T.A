# Copy to .env (project) or ~/.copilot-chat-cli/config.env (global fallback).
USERNAME=krish
AGENT_NAME=ankita
# MODEL=gpt-4.1
# SYSTEM_EXTRA=
TOOLS=on
AUTO_APPROVE=off
HISTORY_MESSAGES=40
# MAX_TOKENS=4096
# MAX_TOOL_CHARS=65536
# CONTEXT_WINDOW=32768
# INPUT_COST_PER_MILLION=
# OUTPUT_COST_PER_MILLION=
# Backend: copilot (default), groq (low latency, reuses GROQ_API_KEY), or
# kilo (Kilo AI Gateway, keyless free models).
# PROVIDER=copilot
# Optional tool-loop model: the primary handles chat and the first tool
# decision; once a turn uses a tool, this model runs the loop and the primary
# writes the reply. Blank = single model for everything.
# TOOL_PROVIDER=kilo
# TOOL_MODEL=nex-agi/nex-n2.5-mini:free
# API_BASE=
# API_KEY=
# GROQ_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# TTS_PROVIDER=auto
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=
# TTS_RATE=+0%
# SPEAK=off
# MIC_DEVICE=
# Hands-free voice (/voice): VAD auto-sends on a pause, barge-in interrupts speech.
# VOICE_VAD=on               # auto-stop + transcribe on silence (off = press Enter)
# VOICE_SILENCE_MS=1200      # pause length that ends a turn
# VOICE_NOISE_DB=-35         # silencedetect threshold
# VOICE_MAX_UTTERANCE_MS=30000
# VOICE_BARGE_IN=on          # talking over a reply interrupts it
# VOICE_BARGE_DB=-25         # barge-in threshold (higher = must be louder)
# VOICE_HFP_ROUTING=on       # keep Bluetooth speech audible while the mic is open
# VOICE_ADDRESS=sir          # salutation in summary notes; off/none disables it
# VOICE_SPEAK_ITEMS=8        # list items read before the "rest on screen" note
# VOICE_SPEAK_SENTENCES=6    # sentences read for long prose
# VOICE_SPEAK_MAX_CHARS=1200 # hard cap on any spoken reply
# VOICE_FULL_READ=off        # on = read replies in full, never summarize
# VOICE_SUMMARY_NOTE={address}, that's {spoken} of {total}. The rest is on your screen, {address}.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_VOICE_REPLY=off
# TELEGRAM_CONFIRM_TIMEOUT=300
# DAEMON_TICK=20
# MAX_CONCURRENT=4
# WATCH_ALERT_LLM=on
# WATCH_ALERT_PROMPT=
# BRIEFING_PROMPT=
# TIMEZONE=Asia/Kolkata  # IANA timezone; defaults to system local time
# QUIET_HOURS=22:00-08:00  # hold proactive notifications for a later digest
# DESKTOP_NOTIFICATIONS=on
# NTFY_URL=https://ntfy.sh/your-private-topic
# NTFY_TOKEN=
# DISCORD_WEBHOOK_URL=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# NOTIFY_TIMEOUT=10
# MEMORY_CONSOLIDATION=on  # also enables local per-turn journaling
# MEMORY_RECALL_CHARS=1600  # transient recall budget; 0 disables automatic candidates
# MEMORY_RECALL_BUDGET_MS=300  # automatic pre-turn recall waits at most this long for a slow embedding; the query still embeds in the background
# EMBEDDINGS=on  # enabled when Cloudflare credentials are configured
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=  # keep in global config.env; never commit tokens
# EMBED_MODEL=@cf/qwen/qwen3-embedding-0.6b
# EMBED_TIMEOUT_MS=2000  # total foreground budget, then local fallback
# EMBED_INDEX_TIMEOUT_MS=30000  # independent background indexing budget
# EMBED_QUERY_INSTRUCTION=Given a conversation message, retrieve relevant personal preferences, facts, past decisions and tasks that help answer it.
# MEMORY_CONSOLIDATION_HOUR=3  # local hour to start processing prior days
# MEMORY_BATCH_SIZE=4
# MEMORY_CHUNK_CHARS=12000
# MEMORY_TIMEOUT=60
# PS_STRICT=1
# ANKITA_NO_WEB=
# ANKITA_NO_SCRAPE=
# WEB_TIMEOUT=20
# WEB_MAX_OUTPUT=8000
# WEB_CACHE_TTL=300
# WEB_RETRIES=1
# WEB_REGION=wt-wt
# JINA_FALLBACK=1
# ALLOW_PRIVATE_HOSTS=1   # opt in to watching loopback/LAN pages (off by default)
# SCRAPE_TIMEOUT=30
# SCRAPE_STEALTH_TIMEOUT=30
# SCRAPE_MAX_OUTPUT=8000
# SCRAPE_MAX_PAGES=20
# SCRAPE_RETRIES=1
# PYTHON_BIN=
