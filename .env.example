LLM_PROVIDER=groq
LLM_MAX_TOKENS=auto

# Vision Provider — for webcam/screenshot analysis (can differ from main LLM)
# Set to 'copilot' to use GPT-4o for vision even when LLM_PROVIDER=groq
# If COPILOT_GITHUB_TOKEN is set, vision auto-falls back to Copilot/GPT-4o
VISION_PROVIDER=copilot
VISION_MODEL=gpt-4o

# Groq mode
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Copilot mode
# Option A: provide GitHub token, ANKITA exchanges to Copilot token automatically.
COPILOT_GITHUB_TOKEN=your_github_token
# Option A2: leave token empty and ANKITA will run GitHub Device Login in browser.
# Option B: provide already exchanged Copilot API token directly.
# COPILOT_API_KEY=your_copilot_api_token
COPILOT_MODEL=gpt-4o
# Optional override, otherwise auto-derived from exchanged token proxy-ep:
# COPILOT_BASE_URL=https://api.individual.githubcopilot.com

# CodeAgent Smart Model Routing (Upgrade 14 — Optional)
# Route coding tasks to different models based on complexity for cost/performance optimization.
# When CODEAGENT_ENABLE_ROUTING=true:
#   - Simple tasks (read file, check syntax, run command) → CODEAGENT_MODEL_SIMPLE
#   - Medium tasks (edit 1-2 files, install package, run tests) → use global LLM_PROVIDER/MODEL
#   - Complex tasks (multi-file refactor, scaffold project, architecture review) → CODEAGENT_MODEL_COMPLEX
# If disabled or models not set, CodeAgent uses global LLM_PROVIDER/MODEL for all tasks.
# CODEAGENT_ENABLE_ROUTING=false
# CODEAGENT_MODEL_SIMPLE=llama-3.1-8b-instant
# CODEAGENT_MODEL_COMPLEX=o1-preview

# Telegram bridge mode (optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional allowlist (comma-separated chat ids)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890

# Gateway mode selection:
# GATEWAY_MODE=telegram
# GATEWAY_MODE=gui
# GATEWAY_MODE=gui+telegram
# Auto-select voice mode when SARVAM_API_KEY is set
# VOICE_WEB_AUTO_SELECT=false

# Realtime web search (Google primary, DuckDuckGo fallback)
# GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id

# Google Maps integration (Phase 1: place search + routes)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional provider selection: auto (default), google, osm
# MAPS_PROVIDER=auto
# Optional fallback origin for "navigate to ..." or "near me" queries
# GOOGLE_MAPS_DEFAULT_ORIGIN=New Delhi
# Map watcher alerts to Telegram (comma-separated chat ids)
# MAPS_NOTIFY_TELEGRAM_CHAT_IDS=123456789,-1001234567890
# Report completion alerts channels (comma-separated): gui,telegram
# REPORT_NOTIFY_CHANNELS=gui,telegram
# Report file format: pdf (default) or md
# REPORT_OUTPUT_FORMAT=pdf
# Task reminder alert channels (comma-separated): gui,telegram
# TASK_NOTIFY_CHANNELS=gui,telegram
# Use Corn scheduler for task reminders (recommended)
# TASK_AGENT_USE_CORN=true
# Task reminder worker poll interval in seconds
# TASK_AGENT_POLL_SEC=15
# Max reminders for a non-repeating pending task
# TASK_MAX_REMINDERS=4
# Optional dedicated chat ids for report alerts (comma-separated)
# REPORT_NOTIFY_TELEGRAM_CHAT_IDS=123456789,-1001234567890
# If REPORT_NOTIFY_TELEGRAM_CHAT_IDS is empty, ANKITA uses:
# 1) MAPS_NOTIFY_TELEGRAM_CHAT_IDS, else
# 2) chat ids auto-registered from Telegram conversations
# GUI inbox poll interval seconds (for map/system alerts)
# GUI_INBOX_POLL_SEC=2

# Sarvam voice gateway (external one-on-one voice interaction)
# SARVAM_API_KEY=your_sarvam_api_key
# VOICE_WEB_HOST=127.0.0.1
# VOICE_WEB_PORT=8765
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe
# VOICE_STT_TIMEOUT_SEC=45
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=Shubh
# SARVAM_TTS_SAMPLE_RATE=16000
# SARVAM_TTS_PACE=1.2
# VOICE_TTS_TIMEOUT_SEC=45
# Voice speech length cap (prevents long TTS latency). If exceeded,
# ANKITA speaks a short summary and tells user the rest is on screen.
# VOICE_TTS_MAX_CHARS=140
# Set 0 to disable truncation and speak full replies (higher latency).
# VOICE_TTS_REST_HINT=I've shown the rest on screen.

# GUI continuous voice call options
# STT provider: sarvam (recommended) or speech_recognition
# VOICE_STT_PROVIDER=sarvam
# VOICE_GUI_LANG=en-IN
# VOICE_GUI_SAMPLE_RATE=16000
# VOICE_GUI_CHUNK_SEC=1.0
# VOICE_GUI_SILENCE_RMS=210
# Lower bound for adaptive silence gate (helps catch softer speech)
# VOICE_GUI_MIN_SILENCE_RMS=65
# Adaptive gate multiplier over estimated noise floor
# VOICE_GUI_SILENCE_MULTIPLIER=1.08
# Minimum share of chunk samples that must look voiced (filters click/fan noise)
# VOICE_GUI_MIN_ACTIVE_RATIO=0.005
# How many silent chunks mark end of phrase before STT runs
# VOICE_GUI_END_SILENCE_CHUNKS=2
# Force-send phrase to STT if speaking continuously for this many seconds
# VOICE_GUI_MAX_PHRASE_SEC=6.0
# Timeout for local speech_recognition transcription before Sarvam fallback
# VOICE_LOCAL_STT_TIMEOUT_SEC=5
# Merge short partial transcripts across nearby chunks (seconds)
# VOICE_PARTIAL_MERGE_WINDOW_SEC=0
# Optional app-level TTS playback gain (0.0 to 1.5).
# Leave unset to fully follow system/master and Windows Volume Mixer.
# VOICE_PLAYBACK_GAIN=0.35
# Optional hard limiter peak ceiling after gain (0.2 to 1.0).
# Leave unset to avoid app-side loudness shaping.
# VOICE_PLAYBACK_PEAK_LIMIT=0.8
# Keep false to stick to default output device (best for system-volume alignment).
# Set true only if default output playback fails on your machine.
# VOICE_OUTPUT_FALLBACK_SCAN=false
# Pause mic briefly after TTS playback to avoid speaker-loop echo pickup.
# VOICE_POST_TTS_COOLDOWN_SEC=1.2
# Ignore transcripts that closely match recent assistant speech.
# VOICE_ECHO_GUARD_WINDOW_SEC=2.0
# Similarity threshold for echo suppression (higher = less aggressive filtering).
# VOICE_ECHO_SIMILARITY_THRESHOLD=0.96
# Ignore exact repeated transcripts arriving in this short window.
# VOICE_DUPLICATE_TRANSCRIPT_WINDOW_SEC=1.2
# VOICE_HOTKEY_ENABLED=true
# VOICE_HOTKEY_KEY=f8
# VOICE_HOTKEY_DOUBLE_PRESS_MS=400

# Corn worker (cron scheduler)
# CORN_AUTO_RUN=true
# CORN_POLL_INTERVAL_SEC=5
# CORN_MAX_JOBS_PER_TICK=5

# Octopus Protocol — Cloud Integration (Google Sheets + YouTube OAuth2)
# Option A: Provide client ID + secret directly
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Option B: Point to downloaded client_secret.json from Google Cloud Console
# GOOGLE_CLIENT_SECRET_FILE=/path/to/client_secret.json
# Tokens are saved to ~/.ankita/tokens.json after first login (no repeat auth needed)

# Figma Integration (Personal Access Token)
# Generate at: https://www.figma.com/settings → Personal access tokens
# FIGMA_ACCESS_TOKEN=your_figma_personal_access_token

# WhatsApp AI Bridge (Ghost Browser mode)
# Comma-separated contact names exactly as saved in phone contacts
# VIP_FRIENDS=Rahul,Aryan,Priya
# Directory to store persistent WhatsApp Web session (QR scanned once)
# WHATSAPP_SESSION_DIR=./whatsapp_session
# How often (seconds) to check for new unread messages
# WHATSAPP_POLL_INTERVAL=5
# Typing delay per keystroke in milliseconds (human-like)
# WHATSAPP_TYPING_DELAY=80
# Run in headless mode after first QR scan (true/false)
# WHATSAPP_HEADLESS=false
# Hijack real Chrome instead of Playwright Chromium (uses existing WhatsApp login)
# WARNING: Close ALL Chrome windows before enabling this!
# WHATSAPP_USE_CHROME=false
# Which Chrome profile to use when WHATSAPP_USE_CHROME=true
# WHATSAPP_CHROME_PROFILE=Default
# Enable tick-by-tick debug logging (prints what the bridge sees each poll cycle)
# WHATSAPP_DEBUG=false
