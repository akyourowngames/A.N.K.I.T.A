# Copy to .env (project) or ~/.copilot-chat-cli/config.env (global fallback).
USERNAME=krish
AGENT_NAME=ankita
# MODEL=gpt-4.1
# SYSTEM_EXTRA=
TOOLS=on
AUTO_APPROVE=off
HISTORY_MESSAGES=40
# MAX_TOKENS=4096
# MAX_TOOL_CHARS=65536
# CONTEXT_WINDOW=32768
# INPUT_COST_PER_MILLION=
# OUTPUT_COST_PER_MILLION=
# Backend: copilot (default) or kilo (Kilo AI Gateway, keyless free models).
# PROVIDER=copilot
# API_BASE=
# API_KEY=
# GROQ_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# TTS_PROVIDER=auto
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=
# TTS_RATE=+0%
# SPEAK=off
# MIC_DEVICE=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_VOICE_REPLY=off
# TELEGRAM_CONFIRM_TIMEOUT=300
# DAEMON_TICK=20
# MAX_CONCURRENT=4
# WATCH_ALERT_LLM=on
# WATCH_ALERT_PROMPT=
# BRIEFING_PROMPT=
# TIMEZONE=Asia/Kolkata  # IANA timezone; defaults to system local time
# QUIET_HOURS=22:00-08:00  # hold proactive notifications for a later digest
# DESKTOP_NOTIFICATIONS=on
# NTFY_URL=https://ntfy.sh/your-private-topic
# NTFY_TOKEN=
# DISCORD_WEBHOOK_URL=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# NOTIFY_TIMEOUT=10
# MEMORY_CONSOLIDATION=on  # also enables local per-turn journaling
# MEMORY_RECALL_CHARS=1600  # transient local recall budget; 0 disables automatic candidates
# MEMORY_CONSOLIDATION_HOUR=3  # local hour to start processing prior days
# MEMORY_BATCH_SIZE=4
# MEMORY_CHUNK_CHARS=12000
# MEMORY_TIMEOUT=60
# PS_STRICT=1
# ANKITA_NO_WEB=
# ANKITA_NO_SCRAPE=
# WEB_TIMEOUT=20
# WEB_MAX_OUTPUT=8000
# WEB_CACHE_TTL=300
# WEB_RETRIES=1
# WEB_REGION=wt-wt
# JINA_FALLBACK=1
# ALLOW_PRIVATE_HOSTS=1   # opt in to watching loopback/LAN pages (off by default)
# SCRAPE_TIMEOUT=30
# SCRAPE_STEALTH_TIMEOUT=30
# SCRAPE_MAX_OUTPUT=8000
# SCRAPE_MAX_PAGES=20
# SCRAPE_RETRIES=1
# PYTHON_BIN=
