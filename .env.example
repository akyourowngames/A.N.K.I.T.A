NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TOOL_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MEMORY_MODEL=nvidia/nemotron-mini-4b-instruct

NVIDIA_STREAM=true
NIM_STREAM_MODE=native
NIM_RETRY_ATTEMPTS=2
NIM_RETRY_DELAY_SECONDS=2
NVIDIA_TIMEOUT_SECONDS=10

JARVIS_AUTO_TOOLS=true
NIM_TOOL_MODE=json
USER_NAME=User
AI_NAME=JARVIS
TEMPERATURE=0.4
MAX_TOKENS=1024

MEMORY_EXTRACT_FROM_CHAT=true
MEMORY_EXTRACT_BACKGROUND=false
