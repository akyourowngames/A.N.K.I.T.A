NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-3b-instruct
NVIDIA_TOOL_MODEL=mistralai/mistral-nemotron
NVIDIA_MEMORY_MODEL=nvidia/nemotron-mini-4b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

NVIDIA_STREAM=true
NIM_STREAM_MODE=native
NIM_RETRY_ATTEMPTS=2
NIM_RETRY_DELAY_SECONDS=0.75
NVIDIA_TIMEOUT_SECONDS=30

JARVIS_AUTO_TOOLS=true
NIM_TOOL_MODE=json
NIM_PARALLEL_TOOL_CALLS=true
NIM_NATIVE_PLANNER_CONFIRM=true
NIM_NATIVE_VERIFY_NO_TOOL=false
NIM_DIRECT_SINGLE_TOOL_RESULT=true
TOOL_PLANNER_PASSES=1
TOOL_PLANNER_MAX_TOKENS=128
TOOL_PLANNER_DESCRIPTION_CHARS=120
TOOL_PLANNER_FIELD_DESCRIPTIONS=false
USER_NAME=User
AI_NAME=JARVIS
TEMPERATURE=0.4
MAX_TOKENS=1024

MEMORY_EXTRACT_FROM_CHAT=true
MEMORY_EXTRACT_BACKGROUND=false
MEMORY_VECTOR_ACTIVE=false
MEMORY_VECTOR_BACKGROUND_REINDEX=true
MEMORY_VECTOR_QUERY_TIMEOUT_SECONDS=2.5
MEMORY_VECTOR_RETRY_ATTEMPTS=2
MEMORY_VECTOR_RETRY_DELAY_SECONDS=0.75
MEMORY_VECTOR_QUERY_RETRY_ATTEMPTS=0
MEMORY_VECTOR_CHUNK_CHARS=900
MEMORY_VECTOR_TOP_K=5
MEMORY_VECTOR_CONTEXT_CHARS=1600

JARVIS_EXTENSIONS_DIR=extensions
JARVIS_ENABLED_EXTENSIONS=
JARVIS_DISABLED_EXTENSIONS=
JARVIS_SKILLS_DIR=skills
JARVIS_SKILL_CONTEXT_CHARS=8000
JARVIS_WEB_SEARCH_URL=https://duckduckgo.com/html/
JARVIS_ENTERTAINMENT_CONFIG=config/entertainment_agent.json
JARVIS_ENTERTAINMENT_LIBRARY_DIR=media/music
JARVIS_ENTERTAINMENT_DRY_RUN_PLAYER=false

VOICE_ENABLED=true
VOICE_SPACE_TRIGGER=true
VOICE_LISTEN_WAIT_TIMEOUT_SECONDS=20
VOICE_LISTEN_AFTER_TTS_DELAY_SECONDS=0.35
JARVIS_VOICE_PROFILE_FILE=config/voice_profiles.json
JARVIS_VOICE_PROFILE=heavy_english_jarvis

STT_ENABLED=true
STT_PROVIDER=nvidia
STT_NVIDIA_SERVER=grpc.nvcf.nvidia.com:443
STT_NVIDIA_FUNCTION_ID=
STT_NVIDIA_LANGUAGE_CODE=en-US
STT_NVIDIA_USE_SSL=true
STT_NVIDIA_STREAMING=true
STT_NVIDIA_STREAMING_CHUNK_BYTES=3200
STT_NVIDIA_AUTOMATIC_PUNCTUATION=true
STT_SAMPLE_RATE=16000
STT_INPUT_DEVICE=
STT_START_TIMEOUT_SECONDS=3
STT_LISTEN_MAX_SECONDS=6
STT_LISTEN_MIN_SECONDS=0.2
STT_POST_SPEECH_SILENCE_SECONDS=0.25
STT_ENERGY_THRESHOLD=650
STT_MIN_SPEECH_RMS=0.035
STT_NOISE_SAMPLE_SECONDS=0.25
STT_NOISE_MULTIPLIER=2.4
STT_PREROLL_SECONDS=0.2
STT_INPUT_GAIN=1.0

TTS_ENABLED=true
TTS_PROVIDER=nvidia
TTS_VOICE=
TTS_RATE=
TTS_VOLUME=
TTS_PITCH=
TTS_NVIDIA_SERVER=grpc.nvcf.nvidia.com:443
TTS_NVIDIA_FUNCTION_ID=
TTS_NVIDIA_LANGUAGE_CODE=en-US
TTS_NVIDIA_USE_SSL=true
TTS_NVIDIA_SAMPLE_RATE=44100
TTS_NVIDIA_STREAMING=true
TTS_NVIDIA_SSML=true
TTS_VOICE_EFFECT=
TTS_HEAVY_PITCH_FACTOR=
TTS_HEAVY_DARKNESS=
TTS_PLAYBACK_SPEED=
TTS_MAX_SPEAK_CHARS=300
TTS_SPEAK_ONESHOT=false
