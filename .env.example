# NVIDIA NIM settings
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model selection - supports many NVIDIA models
# Fast models: meta/llama-3.1-8b-instruct, google/gemma-2-9b-it, microsoft/phi-3-mini-128k-instruct
# Balanced models: meta/llama-3.1-70b-instruct, nvidia/nemotron-3-nano-30b-a3b, mistralai/mixtral-8x22b-instruct-v0.1
# Powerful models: meta/llama-3.1-405b-instruct, mistralai/mistral-large-2
# Code models: qwen/qwen2.5-coder-32b-instruct
# Vision models: nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_POWERFUL_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_VISION_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_CODE_MODEL=qwen/qwen2.5-coder-32b-instruct
NVIDIA_CHAT_MAX_TOKENS=1024

# Embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_BATCH_SIZE=64

# Latency optimization
DECISION_CACHE_ENABLED=true
DECISION_CACHE_TTL=300
DECISION_CACHE_SIZE=500
VECTOR_STORE_CACHE_ENABLED=true
SPECULATIVE_EXECUTION_ENABLED=true

# Chat history indexing
VECTOR_INDEX_CHAT_HISTORY=false

# Realtime web search
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Multiple API keys for rotation
# GROQ_API_KEY_2=your_second_api_key
# GROQ_API_KEY_3=your_third_api_key
