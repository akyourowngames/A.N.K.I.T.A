# --- Single place to switch provider/model (change only these three) ---
ZUMBA_API_KEY=your_key_here
ZUMBA_BASE_URL=https://integrate.api.nvidia.com/v1
ZUMBA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Provider-specific overrides (optional, backward compat). ZUMBA_* wins.
NVIDIA_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=
# Legacy Kilo gateway keys still work as fallbacks.
KILO_API_KEY=
KILO_BASE_URL=
# Knowledge-graph provider (chat stays on NIM): needs clean structured JSON.
ZUMBA_KNOWLEDGE_MODEL=nex-agi/nex-n2.5-mini:free
# Single source of truth: 1 = graph only (user.md never read nor regenerated).
ZUMBA_NO_USER_MD=0
ZUMBA_NO_EMOJI=1
ZUMBA_FORCE_EMOJI=0
ZUMBA_NO_WEB=0
ZUMBA_WEB_TIMEOUT=20
ZUMBA_WEB_MAX_OUTPUT=8000
ZUMBA_WEB_CACHE_TTL=300
ZUMBA_WEB_RETRIES=1
ZUMBA_WEB_REGION=wt-wt
ZUMBA_WEB_JINA_FALLBACK=1
ZUMBA_NO_SCRAPE=0
ZUMBA_SCRAPE_TIMEOUT=30
ZUMBA_SCRAPE_STEALTH_TIMEOUT=30
ZUMBA_SCRAPE_MAX_OUTPUT=8000
ZUMBA_SCRAPE_MAX_PAGES=20
ZUMBA_SCRAPE_RETRIES=1
ZUMBA_NO_FS=0
ZUMBA_FS_MAX_OUTPUT=8000
ZUMBA_FS_SEARCH_TIMEOUT=15
ZUMBA_NO_VAULT=0
ZUMBA_TG_BOT_TOKEN=
ZUMBA_TG_ALLOWED_CHAT_IDS=
ZUMBA_TG_VOICE_REPLY=1
ZUMBA_TG_VOICE_MAX_SEC=300
ZUMBA_NO_GEO=0
ZUMBA_OSRM_URL=
ZUMBA_TT_KEY=
ZUMBA_OVERPASS_URL=
ZUMBA_GEO_TRACK_MAX_MIN=90
# Desktop voice GUI (python desktop/run.py; needs requirements-desktop.txt).
ZUMBA_ASSISTANT_NAME=Zumba
ZUMBA_USERNAME=Sir
ZUMBA_STT_LANG=hi
ZUMBA_TTS_VOICE=en-US-GuyNeural

