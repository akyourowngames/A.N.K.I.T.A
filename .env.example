NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
STT_PROVIDER=local
STT_LOCAL_MODEL=small
STT_LOCAL_DEVICE=auto
STT_LOCAL_COMPUTE_TYPE=int8
STT_LOCAL_BEAM_SIZE=5
STT_INPUT_DEVICE=
STT_ENGLISH_CONVERSION=auto
STT_MODEL=gpt-4o-transcribe
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
STT_TRANSLATION_MODEL=whisper-1
STT_SAMPLE_RATE=16000
STT_LISTEN_MAX_SECONDS=20
STT_LISTEN_MIN_SECONDS=0.8
STT_SILENCE_SECONDS=1.4
STT_CALIBRATION_SECONDS=0.6
STT_MIN_ENERGY=80
STT_ENERGY_MULTIPLIER=1.6
TAVILY_API_KEY=your_tavily_api_key_here
MEMORY_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
MEMORY_BACKEND=nvidia
MEMORY_TOP_K=6
MEMORY_SEARCH_MODE=hybrid
PC_MONITOR_ENABLED=true
PC_MONITOR_INTERVAL_SECONDS=30
PC_MONITOR_MAX_RECORDS=500
PC_MONITOR_CONTEXT_RECORDS=8
DAEMON_INTERVAL_SECONDS=60
DAEMON_REPORT_PATH=memory/data/daemon-report.md
DAEMON_RUN_TESTS=true
DAEMON_DEFAULT_MODEL=meta/llama-3.1-8b-instruct
DAEMON_REVIEW_MODEL=meta/llama-3.1-8b-instruct
DAEMON_CODE_REVIEW_MODEL=meta/llama-3.1-8b-instruct
DAEMON_WRITING_MODEL=meta/llama-3.1-8b-instruct
DAEMON_SUMMARY_MODEL=meta/llama-3.1-8b-instruct
USER_NAME=Krish
AI_NAME=JARVIS
TEMPERATURE=0.4
MAX_TOKENS=1024
