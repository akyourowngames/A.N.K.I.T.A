LLM_PROVIDER=groq
LLM_MAX_TOKENS=120

# Groq mode
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Copilot mode
# Option A: provide GitHub token, ANKITA exchanges to Copilot token automatically.
COPILOT_GITHUB_TOKEN=your_github_token
# Option A2: leave token empty and ANKITA will run GitHub Device Login in browser.
# Option B: provide already exchanged Copilot API token directly.
# COPILOT_API_KEY=your_copilot_api_token
COPILOT_MODEL=gpt-4o
# Optional override, otherwise auto-derived from exchanged token proxy-ep:
# COPILOT_BASE_URL=https://api.individual.githubcopilot.com

# Telegram bridge mode (optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional allowlist (comma-separated chat ids)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890

# Gateway mode selection:
# GATEWAY_MODE=telegram
# GATEWAY_MODE=gui
# Auto-select voice mode when SARVAM_API_KEY is set
# VOICE_WEB_AUTO_SELECT=false

# Realtime web search (Google primary, DuckDuckGo fallback)
# GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id

# Sarvam voice gateway (external one-on-one voice interaction)
# SARVAM_API_KEY=your_sarvam_api_key
# VOICE_WEB_HOST=127.0.0.1
# VOICE_WEB_PORT=8765
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=Shubh
# SARVAM_TTS_SAMPLE_RATE=24000
# SARVAM_TTS_PACE=1.15

# GUI continuous voice call options
# STT provider: speech_recognition (default) or sarvam
# VOICE_STT_PROVIDER=speech_recognition
# VOICE_GUI_LANG=en-IN
# VOICE_GUI_SAMPLE_RATE=16000
# VOICE_GUI_CHUNK_SEC=4.0
# VOICE_GUI_SILENCE_RMS=450
# VOICE_HOTKEY_ENABLED=true
# VOICE_HOTKEY_KEY=f8
# VOICE_HOTKEY_DOUBLE_PRESS_MS=400

# Corn worker (cron scheduler)
# CORN_AUTO_RUN=true
# CORN_POLL_INTERVAL_SEC=5
# CORN_MAX_JOBS_PER_TICK=5
