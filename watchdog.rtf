\pard\sb320\sa60\cf1\b\fs52 05\cf2\fs36   BaseWatcher \f1\emdash  \f2 The Self-Healing Core\cf0\b0\fs22\par

\pard\sa200\cf3\fs20 Every watcher inherits from this. Write it once, use it everywhere.\cf0\fs22\par

\pard\sb160\sa160\par

\pard\sb160\sa80\par

\pard\sb80\sa120\cf5 The \cf1\b BaseWatcher\cf5\b0  class is the most important piece. It handles the daemon thread lifecycle, crash recovery with exponential backoff, state persistence, and alert routing. All 4 watchers just override \b _check()\b0  \f1\emdash  \f2 the single method that does the actual monitoring.\cf0\par
\trowd\trgaph160\trrh1\trpaddl160\trpaddr160\trpaddfl3\trpaddfr3
\clcfpat11\clcbpat2\clbrdrl\brdrw2\brdrs\brdrcf2\clbrdrt\brdrw2\brdrs\brdrcf2\clbrdrr\brdrw2\brdrs\brdrcf2\clbrdrb\brdrw2\brdrs\brdrcf2 \cellx9360 
\pard\intbl\sb20\sa20\cf7\f5\fs18 # watchdog_manager.py \f8\emdash  \f5 BaseWatcher skeleton\cf0\f2\fs22\par
\par
\cf7\f5\fs18 class BaseWatcher:\cf0\f2\fs22\par
\cf7\f5\fs18     def __init__(self, name, config, proactive, workspace_root):\cf0\f2\fs22\par
\cf7\f5\fs18         self.name = name\cf0\f2\fs22\par
\cf7\f5\fs18         self.config = config\cf0\f2\fs22\par
\cf7\f5\fs18         self.proactive = proactive          # ProactiveEngine ref\cf0\f2\fs22\par
\cf7\f5\fs18         self.workspace_root = workspace_root\cf0\f2\fs22\par
\cf7\f5\fs18         self._stop = threading.Event()\cf0\f2\fs22\par
\cf7\f5\fs18         self._thread: Optional[threading.Thread] = None\cf0\f2\fs22\par
\cf7\f5\fs18         self._backoff = 1.0                 # seconds, doubles on crash\cf0\f2\fs22\par
\cf7\f5\fs18         self._max_backoff = 300.0            # cap at 5 minutes\cf0\f2\fs22\par
\cf7\f5\fs18         self.state = self._load_state()     # persist across restarts\cf0\f2\fs22\par
\par
\cf7\f5\fs18     def _check(self) -> Optional[str]:      # \f4\u8592?\f8  \f5 OVERRIDE THIS\cf0\f2\fs22\par
\cf7\f5\fs18\lang9         raise NotImplementedError\cf0\f2\fs22\par
\par
\cf7\f5\fs18     def _alert(self, message: str, kind: str = 'watchdog') -> None:\cf0\f2\fs22\par
\cf7\f5\fs18         self.proactive._queue.put(ProactiveEvent(kind, message))\cf0\f2\fs22\par
\par
\cf7\f5\fs18     def _run(self) -> None:                 # self-healing loop\cf0\f2\fs22\par
\cf7\f5\fs18         while not self._stop.is_set():\cf0\f2\fs22\par
\cf7\f5\fs18             try:\cf0\f2\fs22\par
\cf7\f5\fs18                 alert = self._check()\cf0\f2\fs22\par
\cf7\f5\fs18                 if alert:\cf0\f2\fs22\par
\cf7\f5\fs18                     self._alert(alert)\cf0\f2\fs22\par
\cf7\f5\fs18                 self._backoff = 1.0          # reset on success\cf0\f2\fs22\par
\cf7\f5\fs18             except Exception as e:\cf0\f2\fs22\par
\cf7\f5\fs18                 print(f'[\{self.name\}] CRASH: \{e\} \f8\emdash  \f5 retry in \{self._backoff\}s')\cf0\f2\fs22\par
\cf7\f5\fs18                 self._stop.wait(self._backoff)\cf0\f2\fs22\par
\cf7\f5\fs18                 self._backoff = min(self._backoff * 2, self._max_backoff)\cf0\f2\fs22\par
\cf7\f5\fs18                 continue\cf0\f2\fs22\par
\cf7\f5\fs18             self._stop.wait(self.config.get('poll_interval_sec', 120))\cf0\f2\fs22\par
\par
\cf7\f5\fs18     def start(self) -> None:\cf0\f2\fs22\par
\cf7\f5\fs18         self._thread = threading.Thread(target=self._run, daemon=True)\cf0\f2\fs22\par
\cf7\f5\fs18         self._thread.start()\cf0\f2\fs22\par
\par
\cf7\f5\fs18     def stop(self) -> None:\cf0\f2\fs22\par
\cf7\f5\fs18         self._stop.set()\cf0\f3\fs22\cell\row 
\pard\f2\page\par

