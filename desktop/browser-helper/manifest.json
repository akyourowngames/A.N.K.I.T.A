{
  "manifest_version": 3,
  "name": "ANKITA Browser Companion",
  "version": "1.0.0",
  "description": "Pair once with Ankita to control your signed-in browser and attach webpages.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true}],
  "web_accessible_resources": [{"resources": ["content.mjs", "protocol.mjs"], "matches": ["http://*/*", "https://*/*"]}]
}
