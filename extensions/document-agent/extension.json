{
  "id": "document-agent",
  "name": "Document Agent",
  "description": "Stateful document sessions for reading, extracting, annotating, transforming, comparing, merging, and exporting files through the shared report compiler.",
  "prompt_files": [
    "prompts/document-agent.txt"
  ],
  "skill_dirs": [
    "skills"
  ],
  "env": [
    "JARVIS_DOCUMENT_AGENT_CONFIG",
    "JARVIS_REPORT_COMPILER_CONFIG"
  ],
  "tools": [
    {
      "name": "document_status",
      "description": "Inspect active document session, available sessions, supported input/output formats, output folders, and document dependencies.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_status"
      },
      "sort_key": "document.00"
    },
    {
      "name": "document_open",
      "description": "Open a PDF, DOCX, MD, TXT, or CSV file into an active document session and extract structure, headings, tables, metadata, pages, word count, and language.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Local file path or configured path alias."
          },
          "session_id": {
            "type": "string",
            "description": "Optional session id."
          },
          "make_active": {
            "type": "boolean",
            "description": "Whether this session becomes the active document."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_open"
      },
      "sort_key": "document.01"
    },
    {
      "name": "document_read",
      "description": "Read bounded content from an active or specified document session by section heading, page range, or character range.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Document session id. Uses active session when omitted."
          },
          "section_heading": {
            "type": "string",
            "description": "Read a named section."
          },
          "page_start": {
            "type": "integer",
            "description": "First page to read, one-based."
          },
          "page_end": {
            "type": "integer",
            "description": "Last page to read, one-based."
          },
          "start_char": {
            "type": "integer",
            "description": "Start character offset."
          },
          "end_char": {
            "type": "integer",
            "description": "End character offset."
          },
          "max_chars": {
            "type": "integer",
            "description": "Maximum returned characters."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_read"
      },
      "sort_key": "document.02"
    },
    {
      "name": "document_extract",
      "description": "Extract structured data from a document session: outline, headings, tables, images, citations, metadata, or a named section.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Document session id. Uses active session when omitted."
          },
          "operation": {
            "type": "string",
            "enum": [
              "outline",
              "headings",
              "tables",
              "images",
              "citations",
              "metadata",
              "section"
            ],
            "description": "Extraction operation."
          },
          "section_heading": {
            "type": "string",
            "description": "Section name for operation section."
          },
          "max_chars": {
            "type": "integer",
            "description": "Maximum characters for section extraction."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_extract"
      },
      "sort_key": "document.03"
    },
    {
      "name": "document_annotate",
      "description": "Add a comment, highlight, or margin note to the active or specified document session.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Document session id. Uses active session when omitted."
          },
          "kind": {
            "type": "string",
            "enum": [
              "comment",
              "highlight",
              "margin_note"
            ],
            "description": "Annotation kind."
          },
          "target": {
            "type": "string",
            "description": "Human-readable target such as section title or phrase."
          },
          "note": {
            "type": "string",
            "description": "Annotation note."
          },
          "location": {
            "type": "object",
            "description": "Optional structured page, section, or character location."
          },
          "text": {
            "type": "string",
            "description": "Optional selected text."
          }
        },
        "required": [
          "note"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_annotate"
      },
      "sort_key": "document.04"
    },
    {
      "name": "document_transform",
      "description": "Apply a session-bound transform such as summarize, executive_summary, key_points, translate, rewrite, or reading_level.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Document session id. Uses active session when omitted."
          },
          "operation": {
            "type": "string",
            "enum": [
              "summarize",
              "executive_summary",
              "key_points",
              "translate",
              "rewrite",
              "reading_level"
            ],
            "description": "Transform operation."
          },
          "section_heading": {
            "type": "string",
            "description": "Optional section to transform."
          },
          "instruction": {
            "type": "string",
            "description": "Specific transform instruction."
          },
          "sentences": {
            "type": "integer",
            "description": "Sentence count for summaries."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum key points."
          },
          "max_chars": {
            "type": "integer",
            "description": "Maximum source characters."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_transform"
      },
      "sort_key": "document.05"
    },
    {
      "name": "document_compare",
      "description": "Compare two documents or sessions and return structural diff, content diff, and similarity score.",
      "parameters": {
        "type": "object",
        "properties": {
          "left_session_id": {
            "type": "string",
            "description": "Left document session id."
          },
          "right_session_id": {
            "type": "string",
            "description": "Right document session id."
          },
          "left_path": {
            "type": "string",
            "description": "Left local file path."
          },
          "right_path": {
            "type": "string",
            "description": "Right local file path."
          },
          "max_diff_chars": {
            "type": "integer",
            "description": "Maximum diff characters to return."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_compare"
      },
      "sort_key": "document.06"
    },
    {
      "name": "document_write",
      "description": "Write a document session or structured compiler content to DOCX, MD, PDF, or TXT through the shared report compiler.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Document session id. Uses active session when content is omitted."
          },
          "content": {
            "type": "object",
            "description": "Optional compiler content object."
          },
          "format": {
            "type": "string",
            "enum": [
              "docx",
              "md",
              "pdf",
              "txt"
            ],
            "description": "Output format."
          },
          "template": {
            "type": "string",
            "description": "Report compiler template."
          },
          "output_path": {
            "type": "string",
            "description": "Optional output path."
          },
          "title": {
            "type": "string",
            "description": "Optional title when exporting a session."
          },
          "subtitle": {
            "type": "string",
            "description": "Optional subtitle when exporting a session."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_write"
      },
      "sort_key": "document.07"
    },
    {
      "name": "document_merge",
      "description": "Merge multiple document sessions or local files into one new active document session.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Session ids to merge."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Local files to merge."
          },
          "title": {
            "type": "string",
            "description": "Merged session title."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_merge"
      },
      "sort_key": "document.08"
    },
    {
      "name": "document_close",
      "description": "Close an active or specified document session, optionally saving/exporting first and cleaning cache.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Document session id. Uses active session when omitted."
          },
          "save": {
            "type": "boolean",
            "description": "Export before closing."
          },
          "format": {
            "type": "string",
            "enum": [
              "docx",
              "md",
              "pdf",
              "txt"
            ],
            "description": "Save format."
          },
          "output_path": {
            "type": "string",
            "description": "Optional output path for save."
          },
          "delete_session": {
            "type": "boolean",
            "description": "Delete the session JSON after closing."
          },
          "clean_cache": {
            "type": "boolean",
            "description": "Clean document cache files."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.document_agent",
        "function": "document_close"
      },
      "sort_key": "document.09"
    }
  ]
}
