{
  "id": "browser-agent",
  "name": "Codex Browser Agent",
  "description": "Playwright-backed browser operator with persistent sessions, structured DOM observation, workflow state, recovery, media controls, and network capture.",
  "prompt_files": [
    "prompts/browser-agent.txt"
  ],
  "skill_dirs": [
    "skills"
  ],
  "env": [
    "JARVIS_BROWSER_CONFIG",
    "JARVIS_BROWSER_HEADLESS"
  ],
  "tools": [
    {
      "name": "browser",
      "description": "OpenClaw-style browser controller. Use this as the primary browser tool: status/start/tabs/open/navigate/snapshot/screenshot/act. Snapshot returns e-ref handles; act uses those refs on the same targetId.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["status", "start", "stop", "tabs", "open", "navigate", "snapshot", "screenshot", "act"]
          },
          "profile": {"type": "string"},
          "profile_name": {"type": "string"},
          "targetId": {"type": "string"},
          "label": {"type": "string"},
          "targetUrl": {"type": "string"},
          "url": {"type": "string"},
          "limit": {"type": "integer"},
          "compact": {"type": "boolean"},
          "interactive": {"type": "boolean"},
          "urls": {"type": "boolean"},
          "fullPage": {"type": "boolean"},
          "path": {"type": "string"},
          "timeoutMs": {"type": "integer"},
          "headless": {"type": "boolean"},
          "capture_snapshot": {"type": "boolean"},
          "request": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["click", "clickCoords", "type", "press", "hover", "select", "fill", "wait", "close"]
              },
              "targetId": {"type": "string"},
              "ref": {"type": "string"},
              "selector": {"type": "string"},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "text": {"type": "string"},
              "submit": {"type": "boolean"},
              "slowly": {"type": "boolean"},
              "key": {"type": "string"},
              "values": {"type": "array", "items": {"type": "string"}},
              "fields": {"type": "array", "items": {"type": "object"}},
              "timeMs": {"type": "integer"},
              "selectorWait": {"type": "string"},
              "url": {"type": "string"},
              "loadState": {"type": "string"},
              "textGone": {"type": "string"},
              "timeoutMs": {"type": "integer"}
            },
            "additionalProperties": true
          },
          "kind": {"type": "string"},
          "ref": {"type": "string"},
          "selector": {"type": "string"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "text": {"type": "string"},
          "submit": {"type": "boolean"},
          "slowly": {"type": "boolean"},
          "key": {"type": "string"},
          "values": {"type": "array", "items": {"type": "string"}},
          "fields": {"type": "array", "items": {"type": "object"}},
          "timeMs": {"type": "integer"},
          "textGone": {"type": "string"},
          "loadState": {"type": "string"}
        },
        "required": ["action"],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.browser_agent",
        "function": "browser"
      }
    },
    {
      "name": "browser_status",
      "description": "Inspect Browser Agent readiness, Playwright availability, resolved executable paths, active session, and current page state.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.browser_agent",
        "function": "browser_status"
      }
    },
    {
      "name": "browser_launch",
      "description": "Open or attach a persistent browser session with a named profile. Returns a session_id and writes session state.",
      "parameters": {
        "type": "object",
        "properties": {
          "profile_name": {"type": "string", "description": "Persistent profile name."},
          "browser": {"type": "string", "description": "Browser engine key from config."},
          "headless": {"type": "boolean", "description": "Override configured headless mode."},
          "viewport": {"type": "object", "description": "Optional viewport with width and height."}
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.browser_agent",
        "function": "browser_launch"
      }
    },
    {
      "name": "browser_navigate",
      "description": "Navigate a session to a URL, wait for load state, track redirects, and optionally capture a DOM snapshot.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "url": {"type": "string", "description": "Target URL."},
          "wait_until": {"type": "string", "enum": ["commit", "domcontentloaded", "load", "networkidle"]},
          "capture_snapshot": {"type": "boolean"},
          "timeout_ms": {"type": "integer"}
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.browser_agent",
        "function": "browser_navigate"
      }
    },
    {
      "name": "browser_back",
      "description": "Navigate back in the active browser session and return updated session state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_back"}
    },
    {
      "name": "browser_forward",
      "description": "Navigate forward in the active browser session and return updated session state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_forward"}
    },
    {
      "name": "browser_refresh",
      "description": "Refresh the active page and return updated session state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "wait_until": {"type": "string", "enum": ["domcontentloaded", "load", "networkidle"]}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_refresh"}
    },
    {
      "name": "browser_close",
      "description": "Close a browser session cleanly and persist profile state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_close"}
    },
    {
      "name": "browser_snapshot",
      "description": "Capture a structured DOM snapshot of interactive elements, forms, headings, main text, modals, alerts, frames, and accessibility labels.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "max_elements_per_type": {"type": "integer"}, "include_accessibility_tree": {"type": "boolean"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_snapshot"}
    },
    {
      "name": "browser_state",
      "description": "Return current persisted session state without interacting with the page.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_state"}
    },
    {
      "name": "browser_screenshot",
      "description": "Save a viewport or full-page screenshot for verification and debugging.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "path": {"type": "string"}, "full_page": {"type": "boolean"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_screenshot"}
    },
    {
      "name": "browser_get_text",
      "description": "Extract visible text from a selector or from the main content area.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "max_chars": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_get_text"}
    },
    {
      "name": "browser_get_attribute",
      "description": "Read an attribute from a specific element.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "attribute": {"type": "string"}}, "required": ["selector", "attribute"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_get_attribute"}
    },
    {
      "name": "browser_network_log",
      "description": "Return recent captured network requests and responses for the session.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "limit": {"type": "integer"}, "include_bodies": {"type": "boolean"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_network_log"}
    },
    {
      "name": "browser_click",
      "description": "Click by selector, visible text, ARIA label, or coordinates, then wait for the page to stabilize.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "text": {"type": "string"}, "aria_label": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_click"}
    },
    {
      "name": "browser_type",
      "description": "Type or fill text into an input, optionally clearing first and using human-like typing delay.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "text": {"type": "string"}, "clear": {"type": "boolean"}, "human_like": {"type": "boolean"}, "timeout_ms": {"type": "integer"}}, "required": ["text"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_type"}
    },
    {
      "name": "browser_select",
      "description": "Select from a native or custom dropdown by value, label, or index.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "value": {"type": "string"}, "label": {"type": "string"}, "index": {"type": "integer"}, "timeout_ms": {"type": "integer"}}, "required": ["selector"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_select"}
    },
    {
      "name": "browser_check",
      "description": "Check a checkbox or radio control and return its new state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "required": ["selector"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_check"}
    },
    {
      "name": "browser_uncheck",
      "description": "Uncheck a checkbox and return its new state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "required": ["selector"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_uncheck"}
    },
    {
      "name": "browser_upload",
      "description": "Upload a local file to a file input.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "path": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "required": ["selector", "path"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_upload"}
    },
    {
      "name": "browser_drag",
      "description": "Drag from one element or coordinate to another element or coordinate.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "from_selector": {"type": "string"}, "to_selector": {"type": "string"}, "from_x": {"type": "number"}, "from_y": {"type": "number"}, "to_x": {"type": "number"}, "to_y": {"type": "number"}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_drag"}
    },
    {
      "name": "browser_hover",
      "description": "Hover over an element and return any newly observable structured page state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "text": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_hover"}
    },
    {
      "name": "browser_scroll",
      "description": "Scroll the page or a scrollable container by amount, to an element, or to bottom.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "selector": {"type": "string"}, "amount": {"type": "integer"}, "to": {"type": "string", "enum": ["top", "bottom", "element"]}, "target_selector": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_scroll"}
    },
    {
      "name": "browser_press_key",
      "description": "Press a keyboard key or shortcut in the active page.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "key": {"type": "string"}}, "required": ["key"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_press_key"}
    },
    {
      "name": "browser_handle_dialog",
      "description": "Accept or dismiss a pending browser alert, confirm, or prompt dialog.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "action": {"type": "string", "enum": ["accept", "dismiss"]}, "text": {"type": "string"}}, "required": ["action"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_handle_dialog"}
    },
    {
      "name": "browser_handle_popup",
      "description": "Switch focus to a popup or new tab, capture its state, and optionally close it afterward.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "index": {"type": "integer"}, "close_after": {"type": "boolean"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_handle_popup"}
    },
    {
      "name": "browser_wait_for",
      "description": "Wait for an element, text, URL change, network idle, response, or disappearance condition.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "condition": {"type": "string", "enum": ["element_appears", "element_disappears", "text_appears", "url_changes", "network_idle", "response_received"]}, "selector": {"type": "string"}, "text": {"type": "string"}, "url_pattern": {"type": "string"}, "response_pattern": {"type": "string"}, "timeout_ms": {"type": "integer"}}, "required": ["condition"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_wait_for"}
    },
    {
      "name": "browser_frame_list",
      "description": "List frames and iframes on the current page with URLs, names, and accessibility status.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_frame_list"}
    },
    {
      "name": "browser_frame_switch",
      "description": "Switch interaction context to the main frame or to a frame by index, name, or URL pattern.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "index": {"type": "integer"}, "name": {"type": "string"}, "url_pattern": {"type": "string"}, "main": {"type": "boolean"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_frame_switch"}
    },
    {
      "name": "browser_frame_snapshot",
      "description": "Capture a structured DOM snapshot inside the current frame context.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "max_elements_per_type": {"type": "integer"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_frame_snapshot"}
    },
    {
      "name": "browser_media_play",
      "description": "Find an HTML media player on the page and attempt playback.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_media_play"}
    },
    {
      "name": "browser_media_control",
      "description": "Pause, play, seek, set volume, set playback speed, or toggle fullscreen for page media.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "action": {"type": "string", "enum": ["play", "pause", "seek", "volume", "speed", "fullscreen"]}, "seconds": {"type": "number"}, "volume": {"type": "number"}, "speed": {"type": "number"}}, "required": ["action"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_media_control"}
    },
    {
      "name": "browser_media_state",
      "description": "Read current media state: playing, time, duration, buffer, volume, fullscreen, and track availability.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_media_state"}
    },
    {
      "name": "browser_media_extract",
      "description": "Extract media metadata and available embedded player details from the current page.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_media_extract"}
    },
    {
      "name": "browser_intercept_start",
      "description": "Start capturing network requests and responses matching configured or supplied URL patterns.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "patterns": {"type": "array", "items": {"type": "string"}}, "capture_bodies": {"type": "boolean"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_intercept_start"}
    },
    {
      "name": "browser_intercept_stop",
      "description": "Stop network capture and return captured request and response data.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_intercept_stop"}
    },
    {
      "name": "browser_intercept_mock",
      "description": "Mock matching network responses for workflow testing without triggering real transactions.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "url_pattern": {"type": "string"}, "status": {"type": "integer"}, "content_type": {"type": "string"}, "body": {"type": "string"}}, "required": ["url_pattern", "body"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_intercept_mock"}
    },
    {
      "name": "browser_workflow_start",
      "description": "Start a resumable browser workflow such as flight_search, hotel_search, form_fill, login, product_search, media watch, or custom.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "type": {"type": "string"}, "parameters": {"type": "object"}, "steps": {"type": "array", "items": {"type": "object"}}}, "required": ["type"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_workflow_start"}
    },
    {
      "name": "browser_workflow_step",
      "description": "Execute the next step in the active browser workflow and persist the new workflow state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_workflow_step"}
    },
    {
      "name": "browser_workflow_status",
      "description": "Return active workflow name, current step, total steps, last result, errors, and blocked state.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_workflow_status"}
    },
    {
      "name": "browser_workflow_recover",
      "description": "Attempt recovery from a failed workflow step using retry, back, checkpoint, restart, or escalation strategy.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "strategy": {"type": "string", "enum": ["retry", "back", "checkpoint", "restart", "escalate"]}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_workflow_recover"}
    },
    {
      "name": "browser_workflow_checkpoint",
      "description": "Save the current browser and workflow state as a named checkpoint.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_workflow_checkpoint"}
    },
    {
      "name": "browser_workflow_abort",
      "description": "Cancel the active workflow cleanly and keep the browser session available.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_workflow_abort"}
    },
    {
      "name": "browser_detect_state",
      "description": "Detect high-level page state from structural browser evidence: loading, login wall, captcha, error page, form, results, product, checkout, success, or unknown.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_detect_state"}
    },
    {
      "name": "browser_find_element",
      "description": "Find the best matching interactive element from the DOM snapshot using the user's plain-language description and structural element metadata.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}, "description": {"type": "string"}, "element_type": {"type": "string"}}, "required": ["description"], "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_find_element"}
    },
    {
      "name": "browser_solve_captcha",
      "description": "Attempt permitted CAPTCHA handling and report exactly what was detected, attempted, or why user input is needed.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_solve_captcha"}
    },
    {
      "name": "browser_anti_detect",
      "description": "Apply configured browser anti-detection settings to the active session when a workflow explicitly needs them.",
      "parameters": {"type": "object", "properties": {"session_id": {"type": "string"}}, "additionalProperties": false},
      "executor": {"module": "tools.browser_agent", "function": "browser_anti_detect"}
    }
  ]
}
