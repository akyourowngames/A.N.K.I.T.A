    {
      "name": "entertainment_radio",
      "description": "For radio play/save, use query unless an exact stationuuid is already known; never invent station_id. For user requests to play radio, call operation=play directly; it can search and start the best grounded station. For short follow-ups to the same live station, call play with no query or station_id; it reuses current grounded radio state or the latest grounded radio search. Search-only is for listing or inspecting options.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "search",
              "play",
              "stop",
              "save",
              "list_saved",
              "remove_saved",
              "get_state",
              "trending",
              "similar_to_playing"
            ]
          },
          "query": {
            "type": "string",
            "description": "Station search text or the user's original radio request. Use this for play/save when the station id is not already known."
          },
          "station_id": {
            "type": "string",
            "description": "Exact saved station id or Radio Browser stationuuid from a prior grounded result. Do not use descriptive placeholders like best station."
          },
          "country": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
