      "description": "Prefer this for complex entertainment sessions: status, scan, history, mood, queue, playlist, EQ, volume, crossfade, lyrics, playback.",
      "parameters": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "The user's full session request or desired mood/activity/media mix."
          },
          "context": {
            "type": "string",
            "description": "Activity context such as working, workout, sleeping, driving, studying, partying, or casual."
          },
          "local_only": {
            "type": "boolean"
          },
          "scan": {
            "type": "boolean"
          },
          "start_playback": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer"
          },
          "minimum_local_tracks": {
            "type": "integer"
          },
          "shuffle_mode": {
            "type": "string"
          },
          "eq_profile": {
            "type": "string"
          },
          "volume": {
            "type": "integer",
            "description": "Requested playback volume, 0-100."
          },
          "crossfade_seconds": {
            "type": "integer",
            "description": "Requested crossfade overlap in seconds."
          },
          "fetch_lyrics": {
            "type": "boolean",
            "description": "True when the user asks to fetch, show, or check lyrics."
          },
          "include_history": {
            "type": "boolean",
            "description": "True when the user asks for listening history or history summary."
          },
          "target_minutes": {
            "type": "integer",
            "description": "Requested target session duration in minutes."
