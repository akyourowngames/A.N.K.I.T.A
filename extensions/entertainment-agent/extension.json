{
  "id": "entertainment-agent",
  "name": "Codex Entertainment Agent",
  "description": "Entertainment operating system for local media, streaming, playback, queues, playlists, mood, recommendations, lyrics, radio, podcasts, history, metadata, EQ, and sharing.",
  "prompt_files": [
    "prompts/entertainment-agent.txt"
  ],
  "skill_dirs": [
    "skills"
  ],
  "env": [
    "JARVIS_ENTERTAINMENT_CONFIG",
    "JARVIS_ENTERTAINMENT_LIBRARY_DIR",
    "JARVIS_ENTERTAINMENT_DRY_RUN_PLAYER",
    "GENIUS_API_KEY",
    "SPOTIFY_CLIENT_ID",
    "SPOTIFY_CLIENT_SECRET",
    "LASTFM_API_KEY",
    "ACOUSTID_API_KEY"
  ],
  "tools": [
    {
      "name": "entertainment_status",
      "description": "Status-only entertainment check. For combined status, scan, mood, queue, EQ, playback, or upcoming workflows, prefer entertainment_session.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.entertainment_agent",
        "function": "entertainment_status"
      }
    },
    {
