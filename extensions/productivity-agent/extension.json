{
  "id": "productivity-agent",
  "name": "Codex Productivity Agent",
  "description": "Grounded GitHub, Gmail, and Google Calendar operations through registered tools and OAuth-backed Google APIs.",
  "prompt_files": [
    "prompts/productivity-agent.txt"
  ],
  "skill_dirs": [
    "skills"
  ],
  "env": [
    "JARVIS_PRODUCTIVITY_CONFIG",
    "JARVIS_PRODUCTIVITY_DRY_RUN",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "GOOGLE_OAUTH_CLIENT_SECRETS",
    "GMAIL_TOKEN_FILE",
    "GOOGLE_CALENDAR_TOKEN_FILE"
  ],
  "tools": [
    {
      "name": "productivity_status",
      "description": "Inspect the productivity agent config, GitHub CLI availability/auth status, and Google API credential readiness.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.productivity_agent",
        "function": "productivity_status"
      }
    },
    {
      "name": "github_manage",
      "description": "Manage GitHub through the authenticated gh CLI. Supports auth status, repo view, issue list, pull request list, workflow runs, notifications, and issue creation.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "auth_status",
              "repo_view",
              "issue_list",
              "pr_list",
              "workflow_runs",
              "notifications",
              "create_issue"
            ],
            "description": "GitHub operation."
          },
          "repo": {
            "type": "string",
            "description": "Repository in owner/name format. Optional inside a git repo or when config has github.default_repo."
          },
          "state": {
            "type": "string",
            "description": "Issue or PR state such as open, closed, merged, or all when supported by gh."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum returned items."
          },
          "title": {
            "type": "string",
            "description": "Issue title for create_issue."
          },
          "body": {
            "type": "string",
            "description": "Issue body for create_issue."
          },
          "timeout_seconds": {
            "type": "integer",
            "description": "Command timeout."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.productivity_agent",
        "function": "github_manage"
      }
    },
    {
      "name": "gmail_api",
      "description": "Use the real Gmail API through OAuth for auth status/login, listing messages, reading a message, sending mail, or creating a draft. This is the correct tool for private Gmail data or sending/drafting email.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "auth_status",
              "auth_login",
              "list_messages",
              "read_message",
              "send",
              "draft"
            ],
            "description": "Gmail API operation."
          },
          "query": {
            "type": "string",
            "description": "Gmail search query for list_messages."
          },
          "message_id": {
            "type": "string",
            "description": "Gmail message id for read_message."
          },
          "to": {
            "type": "string",
            "description": "Recipient email address for send or draft."
          },
          "cc": {
            "type": "string",
            "description": "Optional CC recipient list."
          },
          "bcc": {
            "type": "string",
            "description": "Optional BCC recipient list."
          },
          "subject": {
            "type": "string",
            "description": "Email subject for send or draft."
          },
          "body": {
            "type": "string",
            "description": "Email body for send or draft."
          },
          "allow_interactive_auth": {
            "type": "boolean",
            "description": "Allow OAuth browser login if the token is missing or expired."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum Gmail messages to return."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.productivity_agent",
        "function": "gmail_api"
      }
    },
    {
      "name": "calendar_api",
      "description": "Use the real Google Calendar API through OAuth for auth status/login, listing events, reading an event, or creating an event. This is the correct tool for private Calendar data or actual event creation.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "auth_status",
              "auth_login",
              "list_events",
              "get_event",
              "api_create_event"
            ],
            "description": "Google Calendar API operation."
          },
          "title": {
            "type": "string",
            "description": "Event title for api_create_event."
          },
          "details": {
            "type": "string",
            "description": "Event details."
          },
          "location": {
            "type": "string",
            "description": "Event location."
          },
          "start": {
            "type": "string",
            "description": "Start time text or RFC3339 dateTime for API event creation."
          },
          "end": {
            "type": "string",
            "description": "End time text or RFC3339 dateTime for API event creation."
          },
          "time_min": {
            "type": "string",
            "description": "RFC3339 lower bound for list_events."
          },
          "time_max": {
            "type": "string",
            "description": "RFC3339 upper bound for list_events."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone for API event creation."
          },
          "allow_interactive_auth": {
            "type": "boolean",
            "description": "Allow OAuth browser login if the token is missing or expired."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum calendar events to return."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.productivity_agent",
        "function": "calendar_api"
      }
    },
    {
      "name": "productivity_config",
      "description": "Read or update the productivity agent config JSON for GitHub defaults, Google API paths, and dry-run settings.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "get",
              "update"
            ],
            "description": "Config operation."
          },
          "values": {
            "type": "object",
            "description": "Top-level JSON values to merge into the config."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.productivity_agent",
        "function": "productivity_config"
      }
    }
  ]
}
