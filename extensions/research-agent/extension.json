{
  "id": "research-agent",
  "name": "Jarvis Research Agent",
  "description": "Evidence-first research pipeline with planning, web search, source reading, ranking, claim extraction, verification, synthesis, dossiers, and watchlists.",
  "prompt_files": [
    "prompts/research-agent.txt"
  ],
  "skill_dirs": [
    "skills"
  ],
  "env": [
    "JARVIS_RESEARCH_CONFIG",
    "TAVILY_API_KEY",
    "JARVIS_WEB_SEARCH_URL"
  ],
  "tools": [
    {
      "name": "research_status",
      "description": "Inspect Research Agent readiness, source policies, search providers, local research store, and watchlist count.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_status"
      },
      "sort_key": "research.00"
    },
    {
      "name": "research_config",
      "description": "Read or update Research Agent config for source policy, query families, quality limits, storage paths, and provider settings.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "get",
              "update"
            ],
            "description": "Config operation."
          },
          "values": {
            "type": "object",
            "description": "Top-level config values to merge for update."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_config"
      },
      "sort_key": "research.01"
    },
    {
      "name": "research_plan",
      "description": "Create a structured research plan from a topic: mode, quality, time window, risk level, source policy, source types, success criteria, and query families.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Raw or normalized topic to research."
          },
          "normalized_topic": {
            "type": "string",
            "description": "Optional clarified topic when the user phrasing is vague."
          },
          "mode": {
            "type": "string",
            "enum": [
              "headlines",
              "briefing",
              "deep_research",
              "timeline",
              "debate_map",
              "market_tech_trend",
              "monitoring"
            ],
            "description": "Research output mode."
          },
          "quality": {
            "type": "string",
            "enum": [
              "fast",
              "standard",
              "deep",
              "verified"
            ],
            "description": "Research quality and source budget."
          },
          "time_window": {
            "type": "string",
            "description": "Research time window such as last 24 hours, last 7 days, or historical."
          },
          "region": {
            "type": "string",
            "description": "Regional angle."
          },
          "language": {
            "type": "string",
            "description": "Preferred language for research."
          },
          "risk_level": {
            "type": "string",
            "description": "Risk level for verification strictness."
          },
          "source_policy": {
            "type": "string",
            "description": "Source policy key from research config."
          },
          "source_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source categories to prefer."
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_plan"
      },
      "sort_key": "research.02"
    },
    {
      "name": "research_search",
      "description": "Run multiple planned research searches through configured providers, deduplicate URLs, and preserve titles, snippets, publishers, query type, and timestamps when available.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Topic to search when queries are not supplied."
          },
          "plan": {
            "type": "object",
            "description": "Plan returned by research_plan."
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Query objects or query strings."
          },
          "quality": {
            "type": "string",
            "description": "Quality budget."
          },
          "count": {
            "type": "integer",
            "description": "Results per query."
          },
          "max_queries": {
            "type": "integer",
            "description": "Maximum queries to run."
          },
          "timeout_seconds": {
            "type": "integer",
            "description": "Search timeout per query."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_search"
      },
      "sort_key": "research.03"
    },
    {
      "name": "research_fetch_sources",
      "description": "Fetch search result URLs or explicit URLs and extract source text, title, publisher, author, published date, updated date, links, and fetch status.",
      "parameters": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URLs to fetch."
          },
          "search_results": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Results returned by research_search."
          },
          "quality": {
            "type": "string",
            "description": "Quality budget."
          },
          "max_sources": {
            "type": "integer",
            "description": "Maximum sources to fetch."
          },
          "max_chars": {
            "type": "integer",
            "description": "Maximum extracted text per source."
          },
          "timeout_seconds": {
            "type": "integer",
            "description": "Fetch timeout per source."
          }
        },
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_fetch_sources"
      },
      "sort_key": "research.04"
    },
    {
      "name": "research_rank_sources",
      "description": "Rank fetched sources using configured authority, recency, primary-source value, content depth, and risk penalties.",
      "parameters": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Fetched sources."
          },
          "source_policy": {
            "type": "string",
            "description": "Source policy key."
          }
        },
        "required": [
          "sources"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_rank_sources"
      },
      "sort_key": "research.05"
    },
    {
      "name": "research_extract_claims",
      "description": "Extract bounded factual claim candidates from fetched source text and attach each claim to source ids, URLs, dates, publishers, entities, and evidence quotes.",
      "parameters": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Fetched or ranked sources."
          },
          "max_claims": {
            "type": "integer",
            "description": "Maximum claims."
          },
          "claims_per_source": {
            "type": "integer",
            "description": "Claim candidates per source."
          }
        },
        "required": [
          "sources"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_extract_claims"
      },
      "sort_key": "research.06"
    },
    {
      "name": "research_verify_claims",
      "description": "Verify claim candidates against fetched sources, count independent supporting publishers, assign confidence, and mark claims needing more sources.",
      "parameters": {
        "type": "object",
        "properties": {
          "claims": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Claims from research_extract_claims."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Ranked sources."
          },
          "source_policy": {
            "type": "string",
            "description": "Source policy key."
          },
          "minimum_independent_sources": {
            "type": "integer",
            "description": "Override required independent source count."
          }
        },
        "required": [
          "claims",
          "sources"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_verify_claims"
      },
      "sort_key": "research.07"
    },
    {
      "name": "research_synthesize",
      "description": "Build an evidence pack from verified claims and ranked sources so the final assistant response can be written naturally from citations and confidence labels.",
      "parameters": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "description": "Plan returned by research_plan."
          },
          "verified_claims": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Verified claims."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Ranked sources."
          },
          "topic": {
            "type": "string",
            "description": "Topic fallback."
          },
          "mode": {
            "type": "string",
            "description": "Output mode."
          },
          "max_claims": {
            "type": "integer",
            "description": "Maximum top claims for the evidence pack."
          }
        },
        "required": [
          "verified_claims",
          "sources"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_synthesize"
      },
      "sort_key": "research.08"
    },
    {
      "name": "research_save",
      "description": "Save a research report or evidence pack as a local dossier and cache the structured evidence under the configured research memory folder.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Research topic."
          },
          "report": {
            "type": "string",
            "description": "Final report text to save."
          },
          "evidence_pack": {
            "type": "object",
            "description": "Evidence pack to save."
          },
          "run_id": {
            "type": "string",
            "description": "Optional run id."
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_save"
      },
      "sort_key": "research.09"
    },
    {
      "name": "research_watchlist",
      "description": "Manage local research watchlists for recurring topics: list, add/update, or remove watchlist entries with mode, frequency, and source policy.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "upsert",
              "add",
              "update",
              "remove"
            ],
            "description": "Watchlist operation."
          },
          "topic": {
            "type": "string",
            "description": "Watchlist topic."
          },
          "mode": {
            "type": "string",
            "description": "Preferred research mode."
          },
          "frequency": {
            "type": "string",
            "description": "Preferred check cadence."
          },
          "source_policy": {
            "type": "string",
            "description": "Source policy key."
          },
          "last_checked": {
            "type": "string",
            "description": "Optional last checked timestamp."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_watchlist"
      },
      "sort_key": "research.10"
    },
    {
      "name": "research_run",
      "description": "Run the full local research pipeline for a topic: plan, multi-query search, fetch, rank, extract claims, verify, synthesize evidence, and optionally save a dossier.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Topic to research."
          },
          "normalized_topic": {
            "type": "string",
            "description": "Clarified topic when the user wording is vague."
          },
          "mode": {
            "type": "string",
            "description": "Research mode."
          },
          "quality": {
            "type": "string",
            "description": "Research quality."
          },
          "time_window": {
            "type": "string",
            "description": "Research time window."
          },
          "region": {
            "type": "string",
            "description": "Regional angle."
          },
          "language": {
            "type": "string",
            "description": "Preferred language."
          },
          "risk_level": {
            "type": "string",
            "description": "Risk level."
          },
          "source_policy": {
            "type": "string",
            "description": "Source policy key."
          },
          "count": {
            "type": "integer",
            "description": "Results per query."
          },
          "max_sources": {
            "type": "integer",
            "description": "Maximum sources to fetch."
          },
          "max_claims": {
            "type": "integer",
            "description": "Maximum claims."
          },
          "timeout_seconds": {
            "type": "integer",
            "description": "Search/fetch timeout."
          },
          "save": {
            "type": "boolean",
            "description": "Save the evidence pack as a local dossier."
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.research_agent",
        "function": "research_run"
      },
      "sort_key": "research.11"
    }
  ]
}
