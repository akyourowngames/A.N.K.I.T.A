{
  "id": "instagram-agent",
  "name": "Codex Instagram Agent",
  "description": "Session-backed Instagram monitoring and account action tools with config-driven dry-run, session storage, monitored profiles, and rate limiting.",
  "prompt_files": [
    "prompts/instagram-agent.txt"
  ],
  "skill_dirs": [
    "skills"
  ],
  "env": [
    "JARVIS_INSTAGRAM_CONFIG",
    "INSTAGRAM_USERNAME",
    "INSTAGRAM_PASSWORD",
    "INSTAGRAM_SESSION_FILE",
    "INSTAGRAM_DRY_RUN"
  ],
  "tools": [
    {
      "name": "instagram_status",
      "description": "Inspect Instagram Agent readiness, instagrapi availability, configured username/session, dry-run state, and monitored profiles.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.instagram_agent",
        "function": "instagram_status"
      }
    },
    {
      "name": "instagram_config",
      "description": "Read or update Instagram Agent config JSON, including dry-run, session file, monitored profiles, post limit, and rate limit.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "get",
              "update"
            ],
            "description": "Config operation."
          },
          "values": {
            "type": "object",
            "description": "Top-level JSON values to merge into the config."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.instagram_agent",
        "function": "instagram_config"
      }
    },
    {
      "name": "instagram_manage",
      "description": "Manage Instagram through instagrapi when installed: login session, own account summary, profile lookup, recent posts, monitored profiles, photo post, like, comment, or DM.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "auth_login",
              "own_summary",
              "profile",
              "recent_posts",
              "monitor_profiles",
              "post_photo",
              "like_media",
              "comment_media",
              "dm"
            ],
            "description": "Instagram operation."
          },
          "username": {
            "type": "string",
            "description": "Instagram username for profile or recent_posts."
          },
          "usernames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Instagram usernames for monitor_profiles."
          },
          "user_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Instagram user ids for DM."
          },
          "amount": {
            "type": "integer",
            "description": "Number of recent posts to inspect."
          },
          "path": {
            "type": "string",
            "description": "Local photo path for post_photo."
          },
          "caption": {
            "type": "string",
            "description": "Caption for post_photo."
          },
          "media_id": {
            "type": "string",
            "description": "Instagram media id for like or comment."
          },
          "text": {
            "type": "string",
            "description": "Comment or DM text."
          },
          "two_factor_code": {
            "type": "string",
            "description": "Optional two-factor code for auth_login."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "executor": {
        "module": "tools.instagram_agent",
        "function": "instagram_manage"
      }
    }
  ]
}
